    {
      "name": "BL-02 Фильтр по firstname=Sally",
      "description": "Auth: none",
      "item": [
        {
          "name": "GET /booking?firstname=Sally",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Ответ - массив', () => pm.expect(json).to.be.an('array'));",
                  "const target = String(pm.collectionVariables.get('sallyBookingId'));",
                  "pm.test('Созданная бронь Sally присутствует в списке', () => {",
                  "    const ids = json.map(x => String(x.bookingid));",
                  "    pm.expect(ids).to.include(target);",
                  "});",
                  "// Точечная проверка первых 5 записей через GET /booking/{id}",
                  "const sample = json.slice(0, 5).map(b => b.bookingid);",
                  "sample.forEach(id => {",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('baseUrl') + '/booking/' + id,",
                  "        method: 'GET',",
                  "        header: { 'Accept': 'application/json' }",
                  "    }, (err, res) => {",
                  "        if (err) { console.log('sendRequest error for id', id, err); return; }",
                  "        if (res.code === 200) {",
                  "            const b = res.json();",
                  "            pm.test('Бронь ' + id + ' - firstname Sally', () => pm.expect(b.firstname).to.eql('Sally'));",
                  "        }",
                  "    });",
                  "});",
                  "console.log('Найдено Sally:', json.length);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking?firstname=Sally",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ],
              "query": [
                {
                  "key": "firstname",
                  "value": "Sally"
                }
              ]
            }
          },
          "response": []
        }
      ]
