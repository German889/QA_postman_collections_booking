{
  "info": {
    "_postman_id": "7af8b48e-7b19-4bf5-a6d6-6e9d867d186d",
    "name": "04 2 - PUT /booking/:id (BP-01..BP-18)",
    "description": "Тест-кейсы для PUT /booking/:id (BP-01..BP-18). Папки идут в порядке выполнения BP-01 -> BP-18. Папка PRECONDITION получает токен и создаёт бронь Jim Brown (bookingId). BP-01 меняет данные на James, поэтому все последующие папки, которым нужна валидная бронь, при необходимости пересоздают её. Переменные коллекции: baseUrl, token, bookingId, bookingId1, notExistId, idemSnapshot, bp12Snapshot.\n\nМетки папок: Auth: none — публичный эндпоинт; Auth: cookie — токен в Cookie: token={{token}}; Auth: basic — Basic Auth admin:password123; Auth: none (negative test) — негативный кейс, авторизация намеренно не отправляется; Auth: cookie/basic (invalid) — авторизация передана, но намеренно невалидна; Auth: bearer (unsupported) — схема Bearer не поддерживается API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "23679580"
  },
  "item": [
    {
      "name": "PRECONDITION Токен + создать бронь",
      "description": "Auth: none\n\nОба шага публичные: POST /auth выдаёт токен, POST /booking создаёт бронь. Токен сохраняется в переменную {{token}} и используется в защищённых папках BP-01, BP-04..BP-07, BP-11..BP-17.",
      "item": [
        {
          "name": "Step 1 - POST /auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));\nconst json = pm.response.json();\npm.test('token не пустой', () => pm.expect(json.token).to.be.a('string').and.not.empty);\npm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"admin\",\"password\":\"password123\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Step 2 - POST /booking (Jim Brown)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));\nconst json = pm.response.json();\npm.test('bookingid - число', () => pm.expect(json.bookingid).to.be.a('number'));\npm.collectionVariables.set('bookingId', json.bookingid);\nconsole.log('PRECONDITION bookingId =', json.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstname\":\"Jim\",\"lastname\":\"Brown\",\"totalprice\":111,\"depositpaid\":true,\"bookingdates\":{\"checkin\":\"2018-01-01\",\"checkout\":\"2019-01-01\"},\"additionalneeds\":\"Breakfast\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "BP-01 Полное обновление с токеном",
      "description": "Auth: cookie\n\nЗащищённый PUT /booking/:id с валидным токеном в Cookie: token={{token}}.",
      "item": [
        {
          "name": "PUT /booking/{{bookingId}} - Cookie token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));\nconst json = pm.response.json();\npm.test('firstname обновлён на James', () => pm.expect(json.firstname).to.eql('James'));\npm.test('lastname сохранён', () => pm.expect(json.lastname).to.eql('Brown'));\npm.test('totalprice сохранён', () => pm.expect(json.totalprice).to.eql(111));\npm.test('bookingdates сохранены', () => {\n    pm.expect(json.bookingdates.checkin).to.eql('2018-01-01');\n    pm.expect(json.bookingdates.checkout).to.eql('2019-01-01');\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "token={{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstname\":\"James\",\"lastname\":\"Brown\",\"totalprice\":111,\"depositpaid\":true,\"bookingdates\":{\"checkin\":\"2018-01-01\",\"checkout\":\"2019-01-01\"},\"additionalneeds\":\"Breakfast\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
