    {
      "name": "BG-12 Удалённая бронь",
      "description": "Auth: cookie\n\nStep 1 (POST /booking) публичный. Step 2 (DELETE /booking/:id) требует токен - используется заголовок Cookie: token={{token}}, полученный в PRECONDITION. Step 3 (GET) публичный.",
      "item": [
        {
          "name": "Step 1 - POST /booking (создать временную бронь)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));\nconst json = pm.response.json();\npm.test('bookingid - число', () => pm.expect(json.bookingid).to.be.a('number'));\npm.collectionVariables.set('deletedBookingId', json.bookingid);\nconsole.log('BG-12 временная бронь:', json.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"firstname\":\"Temp\",\"lastname\":\"Delete\",\"totalprice\":1,\"depositpaid\":false,\"bookingdates\":{\"checkin\":\"2024-01-01\",\"checkout\":\"2024-01-02\"}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Step 2 - DELETE /booking/{{deletedBookingId}} (с токеном)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('BG-12 DELETE status:', pm.response.code);\npm.test('Status 201 (успешное удаление)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}"
              },
              {
                "key": "Authorization",
                "value": "Basic YWRtaW46cGFzc3dvcmQxMjM="
              }
            ],
