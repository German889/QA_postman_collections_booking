    {
      "name": "BG-01 Получение существующей брони",
      "description": "Auth: none",
      "item": [
        {
          "name": "GET /booking/{{bookingId}}",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));\nconst json = pm.response.json();\npm.test('Все поля схемы Booking присутствуют', () => {\n    pm.expect(json).to.have.property('firstname');\n    pm.expect(json).to.have.property('lastname');\n    pm.expect(json).to.have.property('totalprice');\n    pm.expect(json).to.have.property('depositpaid');\n    pm.expect(json).to.have.property('bookingdates');\n    pm.expect(json.bookingdates).to.have.property('checkin');\n    pm.expect(json.bookingdates).to.have.property('checkout');\n});\npm.test('Данные совпадают с созданными', () => {\n    pm.expect(json).to.deep.include({\n        firstname: 'Jim',\n        lastname: 'Brown',\n        totalprice: 111,\n        depositpaid: true,\n        bookingdates: { checkin: '2018-01-01', checkout: '2019-01-01' }\n    });\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
