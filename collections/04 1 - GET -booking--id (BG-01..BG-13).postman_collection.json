    {
      "name": "BG-04 Типы полей",
      "description": "Auth: none",
      "item": [
        {
          "name": "GET /booking/{{bookingId}} - проверка типов",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));\nconst json = pm.response.json();\npm.test('totalprice - число', () => pm.expect(json.totalprice).to.be.a('number'));\npm.test('depositpaid - boolean', () => pm.expect(json.depositpaid).to.be.a('boolean'));\npm.test('checkin - строка формата YYYY-MM-DD', () => {\n    pm.expect(json.bookingdates.checkin).to.be.a('string');\n    pm.expect(json.bookingdates.checkin).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);\n});\npm.test('checkout - строка формата YYYY-MM-DD', () => {\n    pm.expect(json.bookingdates.checkout).to.be.a('string');\n    pm.expect(json.bookingdates.checkout).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);\n});"
                ]
              }
            }
          ],
